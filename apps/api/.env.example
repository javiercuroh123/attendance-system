# ─── Servidor ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Base de datos ───────────────────────────────────────────────────
# Railway provee DATABASE_URL automáticamente al agregar PostgreSQL.
# Si no usas Railway, define las variables individuales debajo.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Solo necesarias si NO usas DATABASE_URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=app_api
# DB_PASSWORD=tu_password
# DB_NAME=attendance_db

# En el primer despliegue pon true para crear las tablas, luego vuelve a false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ─── JWT ─────────────────────────────────────────────────────────────
# Genera un secreto seguro: openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_al_menos_32_caracteres

# ─── Correo (Brevo / SMTP) ───────────────────────────────────────────
FRONTEND_URL=https://tu-frontend.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_clave_smtp
SMTP_FROM="Asistencia QR" <correo@tudominio.com>
